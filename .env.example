# Copy to .env.local and fill in from Supabase → Project Settings → API.
# The anon key is safe to expose in the browser; NEVER put the service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Optional: which athlete to display (defaults to the first row in `athletes`)
VITE_ATHLETE_ID=
