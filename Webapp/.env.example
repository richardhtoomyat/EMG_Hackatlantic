# Copy to .env.local and fill in from Supabase → Project Settings → API.
# The anon key is safe to expose in the browser; NEVER put the service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Optional, for `npm run dev`: where the /api functions run (e.g. the Vercel deployment
# or `vercel dev`). Empty = same site.
# VITE_API_URL=https://emg-hackatlantic.vercel.app

# Server-only (Vercel → Settings → Environment Variables; used by api/, never the browser):
#   SUPABASE_URL=https://your-project-ref.supabase.co
#   SUPABASE_SERVICE_ROLE_KEY=...
#   KV_REST_API_URL / KV_REST_API_TOKEN   (added by the Upstash for Redis integration)
