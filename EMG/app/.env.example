# Copy to .env (same folder) — same values as the web app's VITE_SUPABASE_* vars.
# The anon/publishable key only; the bridge never needs the service_role key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# The activateMyo account this laptop records for (asked on first run if missing):
ATHLETE_EMAIL=you@example.com
